soong_namespace {
}

cc_prebuilt_library_shared {
    name: "libbinder-v31",
    vendor: true,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["prebuilts/vndk/v31/arm64/libbinder-v31.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libhidlbase-v31",
    vendor: true,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["prebuilts/vndk/v31/arm64/libhidlbase-v31.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libutils-v31",
    vendor: true,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["prebuilts/vndk/v31/arm64/libutils-v31.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
}
